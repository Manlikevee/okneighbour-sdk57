{
  "expo": {
    "name": "OkNeighbour",
    "slug": "okneighbours-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "okneighbour",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.veetech.okneighboursmobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.veetech.okneighboursmobile",
      "adaptiveIcon": {
        "backgroundColor": "#0E2A1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2A1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OkNeighbour uses your location to show you posts, events and businesses in your area.",
          "locationAlwaysAndWhenInUsePermission": "OkNeighbour uses your location to show you posts, events and businesses in your area."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OkNeighbour needs access to your photos so you can share them in posts and on your profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b5f3ebd1-d3d9-4cc1-8973-7d92e4e74a33"
      }
    }
  }
}